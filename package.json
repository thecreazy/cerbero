{
  "name": "cerbero",
  "version": "1.1.0",
  "description": "Tracking your users interations ",
  "main": "dist/cerbero.js",
  "module": "dist/cerbero.esm.js",
  "browser": "dist/cerbero.umd.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.ts' --fix",
    "build": "rollup -c rollup.config.js",
    "dev": "concurrently 'npm run dev:watch' 'npm run dev:serve' ",
    "dev:watch": "rollup -c rollup.config.js -w",
    "dev:serve": "http-server ./docs -p 3001",
    "prepare": "husky",
    "prepublish": "npm run build",
    "release": "standard-version",
    "commit": "npx git-cz",
    "test": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecreazy/cerbero.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "library",
    "tracking"
  ],
  "author": "@thecreazy <canella_riccardo@icloud.com> (https://canellariccardo.it)",
  "contributors": [
    "@TheBous <thebous1993@gmail.com> ()"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thecreazy/cerbero/issues"
  },
  "homepage": "https://github.com/thecreazy/cerbero#readme",
  "files": [
    "dist"
  ],
  "dependencies": {
    "web-vitals": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-external-helpers": "^7.25.0",
    "@babel/plugin-transform-destructuring": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^26.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@types/jest": "^29.0.0",
    "commitizen": "^4.1.2",
    "concurrently": "^9.0.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.0.0",
    "http-server": "^14.0.0",
    "husky": "^9.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "standard-version": "^9.1.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.8.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "rootDir": "./",
    "setupFiles": ["./jest.setup.js"],
    "transform": {
      ".(ts|tsx)": "ts-jest"
    },
    "testEnvironment": "jest-environment-jsdom",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/",
      "/dist"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 99,
        "lines": 99,
        "statements": 99
      }
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.{js,ts}"
    ]
  }
}
