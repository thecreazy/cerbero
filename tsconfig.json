{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist/declaration",
    "module": "es2020",
    "noImplicitAny": false,
    "outDir": "./dist",
    "target": "es2017",
    "moduleResolution": "Node",
    "lib": ["es2017", "dom"],
    "strict": false,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
